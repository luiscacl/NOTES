<?xml version="1.0" encoding="UTF-8"?>
<!--
    Parte 1: el núcleo de Spring y de Spring Boot (contenedor, autoconfiguración,
    configuración). No necesita web ni base de datos: solo el starter base.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.practice.spring</groupId>
        <artifactId>spring-guides</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>part1_core</artifactId>
    <name>part1_core</name>

    <dependencies>
        <!-- El contenedor de Spring, la autoconfiguración, el log y YAML. Sin versión: la pone el padre. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Bean Validation: para validar la configuración al arrancar (config/ExternalConfiguration). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Solo para las pruebas: JUnit 5, AssertJ, Mockito y las utilidades de Spring para probar. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
