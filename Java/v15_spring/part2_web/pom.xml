<?xml version="1.0" encoding="UTF-8"?>
<!--
    Parte 2: APIs REST con Spring MVC. Trae el servidor web embebido, JSON y validación.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.practice.spring</groupId>
        <artifactId>spring-guides</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>part2_web</artifactId>
    <name>part2_web</name>

    <dependencies>
        <!-- Spring MVC + servidor embebido + JSON. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- Bean Validation para los datos que llegan (web/Validation). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- RestClient configurado por Boot (para llamar a OTRAS APIs: clients/HttpClients).
             En Boot 4 no viene con el starter webmvc: es un módulo aparte. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>

        <!-- Pruebas: JUnit, AssertJ, MockMvc y los clientes de prueba de Spring MVC. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
